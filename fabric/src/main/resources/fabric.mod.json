{
    "schemaVersion": 1,
    "id": "gardentrails",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/garden-trails"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.dawnoftime.gardentrails.GTFabric"
        ],
        "client": [
            "org.dawnoftime.gardentrails.GTFabric"
        ],
        "jei_mod_plugin": [
            "org.dawnoftime.gardentrails.compat.jei.GTJeiPlugin"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.14",
        "fabric": "*",
        "minecraft": ">=1.21.1 <1.22",
        "java": ">=21"
    }
}
  