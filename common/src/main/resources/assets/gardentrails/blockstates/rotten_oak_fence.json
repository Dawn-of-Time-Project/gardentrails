{
    "multipart": [
        {
            "apply": {
                "model": "gardentrails:block/rotten_oak_fence_post"
            }
        },
        {
            "when": {
                "north": "true"
            },
            "apply": {
                "model": "gardentrails:block/rotten_oak_fence_side",
                "uvlock": true
            }
        },
        {
            "when": {
                "east": "true"
            },
            "apply": {
                "model": "gardentrails:block/rotten_oak_fence_side",
                "uvlock": true,
                "y": 90
            }
        },
        {
            "when": {
                "south": "true"
            },
            "apply": {
                "model": "gardentrails:block/rotten_oak_fence_side",
                "uvlock": true,
                "y": 180
            }
        },
        {
            "when": {
                "west": "true"
            },
            "apply": {
                "model": "gardentrails:block/rotten_oak_fence_side",
                "uvlock": true,
                "y": 270
            }
        }
    ]
}
